# Hosted-router configuration. Do not commit real values.
TRAIL_API_PORT=4317
TRAIL_REQUIRE_API_KEY=true
TRAIL_API_KEY=
TRAIL_CI_KEY=
TRAIL_RATE_LIMIT_MAX=120
TRAIL_RATE_LIMIT_WINDOW="1 minute"
# Raw prompts are deleted after this route-session window unless a customer
# explicitly enables private history.
TRAIL_ROUTE_SESSION_TTL_MS=900000
TRAIL_PRIVATE_HISTORY=false
# Required for the shared hosted router in production. Apply the checked-in
# migration and seed the reviewed corpus before setting this.
TRAIL_POSTGRES_URL=

# Optional local-only source. TRAIL fetches this loopback Claude Mem project
# into a redacted review draft; it never sends the raw context to Supabase.
TRAIL_CLAUDE_MEM_URL=http://127.0.0.1:37701
TRAIL_CLAUDE_MEM_PROJECT=

# Used by the local stdio bridge.
TRAIL_ROUTER_URL=https://trail.example.com/mcp

# Optional model services. Routing remains deterministic if unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_EXTRACTOR_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
