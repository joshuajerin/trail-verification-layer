{
  "name": "trail-verification-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm --filter @trail/contracts build && pnpm --filter @trail/api build && pnpm --filter @trail/mcp build",
    "dev": "pnpm --filter @trail/contracts build && pnpm --filter @trail/api dev",
    "test": "pnpm --filter @trail/contracts build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @trail/contracts build && pnpm -r typecheck",
    "trail": "pnpm --filter @trail/contracts build && pnpm --filter @trail/api trail",
    "start": "pnpm --filter @trail/api start",
    "mcp": "pnpm --filter @trail/mcp start"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
